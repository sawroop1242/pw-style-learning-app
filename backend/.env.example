# Select development locally or production on the deployed backend.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=your-api-host.example.com
DATABASE_URL=postgresql://user:password@host:5432/studyspace
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
