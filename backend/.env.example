# Django
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=django-insecure-local-development-key-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite default for development)
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=

# Security (production)
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Defaults to true when ENVIRONMENT=production; set false to omit the directive.
SECURE_HSTS_PRELOAD=true

# Email (SMTP) - Required for password reset OTP in production
# Gmail example (requires 2FA and App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=StudySpace <your-email@gmail.com>
# SERVER_EMAIL=StudySpace <your-email@gmail.com>

# Development email backend (console output)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
