# Hosting-only exclusions. Nothing here is needed to serve the app, the API or
# the admin, and shipping it would only slow the build down.
#
# `backend/staticfiles` is deliberately NOT listed: it is generated by
# `collectstatic` during the build and must survive into the deployed bundle,
# or the admin would load without its stylesheet.
.git
.github
node_modules
docs
tools/checks
*.sqlite3
*.log
